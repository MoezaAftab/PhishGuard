# ==============================================================================
# PhishGuard Configuration & Environment Variables
# ==============================================================================

# Flask Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=phishguard-dev-secret-key-replace-in-production
PORT=5000

# Rate Limiting (Protects from brute force & denial-of-service)
RATELIMIT_DEFAULT=60/minute
RATELIMIT_SCAN=30/minute

# ------------------------------------------------------------------------------
# Supabase Database Configuration (Optional Cloud DB)
# If provided, scans are automatically synced to your Supabase Cloud PostgreSQL!
# If left blank, PhishGuard automatically falls back to local SQLite (phishguard.db).
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ------------------------------------------------------------------------------
# Optional External Threat Intelligence & OSINT APIs
# If configured, ThreatIntelAgent queries live VirusTotal or Google Safe Browsing feeds.
# If omitted, PhishGuard uses internal DNS, MX, domain reputation, and offline heuristics.
# ------------------------------------------------------------------------------
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key_here
# ------------------------------------------------------------------------------
# Groq LLM Security Analyst
# GPT-OSS 20B is used to synthesize findings from the specialized agents.
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b